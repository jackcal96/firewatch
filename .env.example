# Optional environment overrides. Copy to .env and edit.
# Every value here is optional and overrides configs/default.yaml.

# Camera stream. Keep credentials out of version control.
FIREWATCH_RTSP_URL=rtsp://user:password@192.168.1.10:554/stream1
FIREWATCH_MODEL_PATH=models/best.pt
FIREWATCH_LOG_DIR=logs

# Alert delivery (leave unset to log alerts only).
# FIREWATCH_WEBHOOK_URL=https://hooks.example.com/firewatch
